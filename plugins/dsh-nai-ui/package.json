{
  "name": "dsh-nai-ui",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：为 dsh-nai 与 nai-author preset 提供 Nai 写作台前端界面。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "presets/",
    "scripts/"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "dsh-nai": "file:../dsh-nai"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT"
}
