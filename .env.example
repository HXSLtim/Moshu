# LM Studio（OpenAI兼容接口）
OPENAI_API_KEY=lm-studio
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_MODEL_COMPLEX=google/gemma-4-26b-a4b-qat
OPENAI_MODEL_SIMPLE=google/gemma-4-26b-a4b-qat
# DeepSeek 远程替代配置（按需取消注释并通过本机 .env 注入真实密钥，禁止提交密钥）
# OPENAI_API_KEY=请填写本机密钥
# OPENAI_API_BASE=https://api.deepseek.com/v1
# OPENAI_MODEL_COMPLEX=deepseek-v4-pro
# OPENAI_MODEL_SIMPLE=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
REVIEW_MAX_CONCURRENCY=2

# 本地数据库基线；部署PostgreSQL时覆盖为postgresql://用户:密码@主机:端口/数据库
DATABASE_URL=sqlite:///./novel.db

# PostgreSQL数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Chroma与LM Studio Embedding
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=novel_embeddings
EMBEDDING_ENABLED=true
EMBEDDING_API_BASE=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_TIMEOUT_SECONDS=60

# Redis缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Neo4j知识图谱配置
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# 应用配置
APP_NAME=AI小说创作系统
APP_VERSION=0.1.0
DEBUG=True
# 必填：复制本文件后，用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成并取消下一行注释
# SECRET_KEY=请填写至少32字符的随机值

# CORS配置
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 日志配置
LOG_LEVEL=INFO
