{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "墨枢",
  "version": "0.1.0",
  "identifier": "com.hxsltim.moshu",
  "build": {
    "frontendDist": "../.next-static",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "NEXT_STATIC_BUILD=1 npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nai"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
