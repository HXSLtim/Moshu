{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nai",
  "version": "0.1.0",
  "identifier": "com.hxsltim.moshu",
  "build": {
    "frontendDist": "../.next-static",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "NEXT_STATIC_BUILD=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "墨枢",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "url": "http://localhost:21490/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nai"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
